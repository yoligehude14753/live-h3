# Orchestrator configuration — copy to orchestrator.env and edit.
# One URL per GPU. Use your own hosts' addresses; the IPs below are examples.

# Comma-separated worker URLs (one ComfyUI instance per GPU):
WORKER_URLS=http://192.0.2.10:8188,http://192.0.2.10:8189,http://192.0.2.11:8188

# Port the orchestrator listens on:
ORCHESTRATOR_PORT=8300

# Shard timeout in seconds before re-queueing to another worker:
SHARD_TIMEOUT=300

# Max retries per shard before failing the job:
SHARD_MAX_RETRIES=3
